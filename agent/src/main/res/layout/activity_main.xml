<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/car_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/car_accent"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSetup"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/setup"
            android:textColor="@color/car_accent" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/mode_section"
                android:textColor="@color/car_muted"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/modeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/modeFast"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/mode_fast"
                    android:textColor="@color/car_text" />

                <RadioButton
                    android:id="@+id/modeReasoning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_reasoning"
                    android:textColor="@color/car_text" />

                <RadioButton
                    android:id="@+id/modeJev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_jev"
                    android:textColor="@color/car_text" />
            </RadioGroup>

            <TextView
                android:id="@+id/runPathHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/run_path_hint"
                android:textColor="@color/car_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/devSimSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/car_surface"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dev_sim_section"
                    android:textColor="@color/car_accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/vehicleMockSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:checked="true"
                    android:text="@string/vehicle_mock"
                    android:textColor="@color/car_text" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/mockPresetGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/mockParked"
                            style="@style/Widget.CarGuiAgent.MockChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/mock_preset_parked" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/mockReverse"
                            style="@style/Widget.CarGuiAgent.MockChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mock_preset_reverse" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/mockNeutral"
                            style="@style/Widget.CarGuiAgent.MockChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mock_preset_neutral" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/mockCity"
                            style="@style/Widget.CarGuiAgent.MockChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mock_preset_city" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/mockUrban"
                            style="@style/Widget.CarGuiAgent.MockChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mock_preset_urban" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/mockHighway"
                            style="@style/Widget.CarGuiAgent.MockChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mock_preset_highway" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/vehicleStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/car_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/goalInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/car_surface"
                android:hint="@string/goal_hint"
                android:minLines="2"
                android:padding="14dp"
                android:textColor="@color/car_text"
                android:textColorHint="@color/car_muted" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnListen"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:minHeight="52dp"
                    android:text="@string/listen"
                    android:textColor="@color/car_bg"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnRun"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:minHeight="52dp"
                    android:text="@string/run_goal"
                    android:textColor="@color/car_bg"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnStop"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="52dp"
                    android:text="@string/stop_goal"
                    android:textColor="@color/car_danger"
                    android:textSize="15sp"
                    app:strokeColor="@color/car_danger" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/event_log"
                android:textColor="@color/car_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/eventLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/car_surface"
                android:fontFamily="monospace"
                android:minHeight="160dp"
                android:padding="12dp"
                android:textColor="@color/car_text"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
