<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules file for API < 31.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- Exclude device_id from backup to ensure unique IDs per device/emulator -->
    <exclude domain="sharedpref" path="carrun_device.xml"/>
    <exclude domain="sharedpref" path="carrun_secrets.xml"/>
    <exclude domain="sharedpref" path="carrun_sms.xml"/>
    <exclude domain="sharedpref" path="carrun_audio.xml"/>
    <exclude domain="database" path="carrun_sms.db"/>
    <exclude domain="database" path="carrun_sms.db-wal"/>
    <exclude domain="database" path="carrun_sms.db-shm"/>
</full-backup-content>
